# ESP32-S2 Mini bank (nanacoin-s2.local): one core, 4 MiB flash, 2 MiB PSRAM.
# The S3 bank uses ../../sdkconfig.defaults; never mix the two.
CONFIG_IDF_TARGET="esp32s2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# As on the S3: multi-KiB buffers in PSRAM, internal RAM for DMA, Wi-Fi and
# stacks. The S2 has less internal RAM, so reserve less and move Wi-Fi/lwIP
# buffers to PSRAM where IDF allows it.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
# Stacks of tasks that never write flash (TLS handshakes, diagnostics, LED)
# go to PSRAM; the HTTP/API task and main task keep internal stacks.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# The boxed startup chain measured 22.6 KiB on the S3 (see DEPLOY.md).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESP_TLS_SERVER=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Browsers may send full 16 KiB records; the server's own records can be small.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=768
CONFIG_HTTPD_MAX_URI_LEN=96
# 3 established TLS + 2 HTTP + 1 handshake + 2 completed handoffs +
# 2 listeners, with headroom for DNS/SNTP/mDNS and the accept backlog.
CONFIG_LWIP_MAX_SOCKETS=14
CONFIG_LWIP_MAX_ACTIVE_TCP=14
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y
# Native USB is the only port: boot/panic logs and esptool resets use USB CDC.
CONFIG_ESP_CONSOLE_USB_CDC=y
# miniframework waits in 1 ms steps; at the default 100 Hz each is 10 ms
# and sending is ~15x slower (the framework refuses to build below 1000).
CONFIG_FREERTOS_HZ=1000
