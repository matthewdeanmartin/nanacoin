{
  "name": "nanacoin-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "design": "ng run nanacoin-web:storybook",
    "design:build": "ng run nanacoin-web:build-storybook --quiet",
    "design:check": "prettier --ignore-path ../design_system/.prettierignore --check \"../design_system/**/*.{ts,mjs,css,json,md}\" && tsc --project ../design_system/.storybook/tsconfig.json --noEmit",
    "design:format": "prettier --ignore-path ../design_system/.prettierignore --write \"../design_system/**/*.{ts,mjs,css,json,md}\"",
    "design:rules": "node --test ../design_system/rules/*.test.mjs",
    "test:ci": "ng test --watch=false",
    "test:demo": "ng test --watch=false --build-target nanacoin-web:build:demo",
    "coverage": "ng test --watch=false --coverage --runner-config vitest.coverage.config.mts",
    "coverage:demo": "ng test --watch=false --coverage --build-target nanacoin-web:build:demo --runner-config vitest.coverage-demo.config.mts"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.0",
    "@angular/animations": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/angular": "10.6.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "storybook": "10.6.0",
    "typescript": "~6.0.2",
    "vitest": "4.1.11",
    "zone.js": "0.16.3"
  },
  "description": "NanaCoin household client. Static Angular site; talks to the NanaCoin HTTP API wherever it runs."
}
