{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "e04cbae6-282c-49a0-b18f-d83ce46c1824"
  },
  "newProjectRoot": "projects",
  "projects": {
    "nanacoin-web": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "browserTarget": "nanacoin-web:build:development",
            "configDir": "../design_system/.storybook",
            "tsConfig": "../design_system/.storybook/tsconfig.json",
            "styles": [
              "src/styles.css",
              "../design_system/preview.css"
            ],
            "compodoc": false,
            "port": 6010,
            "host": "127.0.0.1",
            "open": false,
            "sourceMap": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "browserTarget": "nanacoin-web:build:development",
            "configDir": "../design_system/.storybook",
            "tsConfig": "../design_system/.storybook/tsconfig.json",
            "styles": [
              "src/styles.css",
              "../design_system/preview.css"
            ],
            "compodoc": false,
            "outputDir": "../design_system/dist",
            "sourceMap": false
          }
        },
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "allowedCommonJsDependencies": [
              "qrcode"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "nanacoin.webp",
                "input": "assets/hero-board",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "demo": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/demo/demo.ts",
                  "with": "src/app/demo/demo.public.ts"
                }
              ],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public"
                },
                {
                  "glob": "nanacoin.webp",
                  "input": "assets/hero-web",
                  "output": "/"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "nanacoin-web:build:production"
            },
            "development": {
              "buildTarget": "nanacoin-web:build:development"
            },
            "demo": {
              "buildTarget": "nanacoin-web:build:demo"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.mjs"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
